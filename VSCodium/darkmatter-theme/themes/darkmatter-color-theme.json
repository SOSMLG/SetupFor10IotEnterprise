  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f8787",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e75353"
      }
    },
    {
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.ternary",
        "keyword.operator.increment"
      ],
      "settings": {
        "foreground": "#e75353"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.quote",
        "string.template",
        "template-expression"
      ],
      "settings": {
        "foreground": "#fbcb97"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#fbcb97"
      }
    },
    {
      "scope": [
        "number"
      ],
      "settings": {
        "foreground": "#fbcb97"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "string.unquoted.js"
      ],
      "settings": {
        "foreground": "#cdcbcb"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#fbcb97"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "support.variable"
      ],
      "settings": {
        "foreground": "#cdcbcb"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.readwrite.global"
      ],
      "settings": {
        "foreground": "#e75353"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#cdcbcb",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e75353"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#fbcb97"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.type.declaration.body"
      ],
      "settings": {
        "foreground": "#6b6a6c"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#e75353"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e75353",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e75353",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5f8787"
      }
    },
    {
      "scope": [
        "markup.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#e75353",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.code"
      ],
      "settings": {
        "foreground": "#fbcb97"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#e75353"
      }
    }
  ]
}